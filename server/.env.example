PORT=4000
CORS_ORIGIN=http://localhost:5173

# Supabase Configuration (Set actual keys in server/.env, never commit secrets)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# Institution Ed25519 Keypair (Generate with: npm run generate:keys)
INSTITUTION_ID=MARKSURE-UNIV-01
INSTITUTION_PRIVATE_KEY_HEX=
INSTITUTION_PUBLIC_KEY_HEX=
